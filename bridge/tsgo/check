#!/bin/zsh
# TypeScript 前端适配的受控测试驱动。
#
#   ./bridge/tsgo/check
#
# 依次验证：前端源码身份、适配包副本、外部消费者测试、干净输入、类型错误与
# 位置、截断源码、缺文件、外部导入 internal 被拒、源码身份不符被拒、声明库
# 缺失被拒、声明事实、原生能力白名单、void 与丢弃结果、boolean 标量、分支
# 与作用域、返回路径、短路、三元式、条件组合、已初始化的 let、局部赋值、输出
# 格式、从源码降低到可运行的原生程序，以及主命令行的 check、build、run、dump。
#
# 依赖 ./tools/toolchain/prep 已经准备过前端源码；本脚本只读那棵树，不修改它。
# 模块缓存放在 .work/frontend/gomodcache，首次运行需要能访问 Go 模块代理。
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
TREE="$ROOT/.work/frontend/typescript-go"
CONSUMER="$ROOT/bridge/tsgo/consumer"
WORK="$ROOT/.work/frontend"

# 模块代理：本机访问 proxy.golang.org 会返回 502，默认改用国内镜像；
# 依赖下载后会进入 .work/frontend/gomodcache，之后可以离线构建。
export GOPROXY="${TYNEL_GOPROXY:-https://goproxy.cn}"
export GOSUMDB=off
export GOMODCACHE="$WORK/gomodcache"
# 编译缓存用默认位置：它是纯派生数据，放在项目里会让 .work 多出数 GB，
# 而默认缓存还能和其他 Go 构建共用。

failures=0
pass() { print -- "  PASS  $1" }
fail() { print -- "  FAIL  $1"; failures=$((failures + 1)) }

if [[ ! -d "$TREE" ]]; then
  print -u2 -- "找不到前端源码：$TREE"
  print -u2 -- "先运行 ./tools/toolchain/prep --frontend-only"
  exit 1
fi

# 用隔离 SDK 的 go；没有就退回 PATH 里的 go。
GO=$(python3 - "$ROOT" <<'PY'
import json, os, sys
root = sys.argv[1]
path = os.path.join(root, ".work/toolchain/toolchain.json")
try:
    data = json.load(open(path))
    for inst in data.get("installs", []):
        if inst.get("kind") == "sdk":
            print(inst["tools"]["go"])
            break
except Exception:
    pass
PY
)
if [[ -z "${GO:-}" || ! -x "$GO" ]]; then
  GO=$(command -v go || true)
fi
if [[ -z "${GO:-}" || ! -x "$GO" ]]; then
  print -u2 -- "找不到可用的 go；先运行 ./tools/toolchain/prep"
  exit 1
fi
print -- "使用 $("$GO" version)"

# 1. 源码身份与适配包副本
if "$ROOT/tools/toolchain/prep" --verify-only --quiet >/dev/null 2>&1; then
  pass "前端源码身份与适配包副本一致"
else
  fail "前端源码身份或适配包副本不一致"
fi

# 2. 外部消费者测试：会话创建、关闭规则、诊断内容、快照语义
if (cd "$CONSUMER" && "$GO" test -count=1 ./... >/dev/null 2>&1); then
  pass "外部消费者测试通过"
else
  fail "外部消费者测试失败"
fi

# 编译一次宿主，后面反复运行，避免每次都走 go run。
BIN="$WORK/bin/consumer"
mkdir -p "$WORK/bin"
if ! (cd "$CONSUMER" && "$GO" build -o "$BIN" .); then
  fail "无法构建外部宿主"
  print -- "失败 $failures 项"
  exit 1
fi

# 3. 干净输入：无诊断，退出 0
out=$("$BIN" "$ROOT/bridge/tsgo/testdata/add.ts" 2>&1); code=$?
if [[ $code -eq 0 && "$out" == "[]" ]]; then
  pass "干净输入没有诊断（退出 0）"
else
  fail "干净输入应输出 [] 并退出 0，实际退出 $code：$out"
fi

# 4. 类型错误：退出 1，带 2322，并且中文注释之后的行列仍然正确
out=$("$BIN" "$ROOT/bridge/tsgo/testdata/bad.ts" 2>&1); code=$?
if [[ $code -eq 1 ]] && print -- "$out" | grep -q '"code": 2322'; then
  pass "类型错误以 2322 报告（退出 1）"
else
  fail "类型错误应退出 1 并含错误码 2322，实际退出 $code：$out"
fi
if print -- "$out" | grep -q '"line": 2' && print -- "$out" | grep -q '"column": 7'; then
  pass "中文注释之后的位置仍是 2:7"
else
  fail "中文注释之后的位置应为 2:7，实际：$out"
fi

# 5. 截断源码：语法错误，不是崩溃
out=$("$BIN" "$ROOT/bridge/tsgo/testdata/truncated.ts" 2>&1); code=$?
if [[ $code -eq 1 ]] && print -- "$out" | grep -q '"severity": "error"'; then
  pass "截断源码报语法错误（退出 1）"
else
  fail "截断源码应退出 1 并带 error 级诊断，实际退出 $code：$out"
fi

# 6. 缺文件：环境缺失退出 4，与源码错误分开
out=$("$BIN" "$ROOT/bridge/tsgo/testdata/does-not-exist.ts" 2>&1); code=$?
if [[ $code -eq 4 ]] && print -- "$out" | grep -q "环境缺失"; then
  pass "缺文件按环境缺失退出 4"
else
  fail "缺文件应退出 4，实际退出 $code：$out"
fi

# 7. 外部直接导入 internal 包必须被 Go 的访问规则拒绝
probe=$(mktemp -d)
mkdir -p "$probe"
cat > "$probe/go.mod" <<EOF
module probe

go 1.27

require github.com/microsoft/typescript-go v0.0.0

replace github.com/microsoft/typescript-go => $TREE
EOF
cat > "$probe/main.go" <<'EOF'
package main

import "github.com/microsoft/typescript-go/internal/compiler"

func main() { _ = compiler.Program{} }
EOF
out=$(cd "$probe" && GOFLAGS=-mod=mod "$GO" build ./... 2>&1); code=$?
if [[ $code -ne 0 ]] && print -- "$out" | grep -q "use of internal package"; then
  pass "外部导入 internal 包被拒绝"
else
  fail "外部导入 internal 包本应失败，实际退出 $code：$out"
fi
rm -rf "$probe"

# 8. 源码身份不符：换掉 go.mod 的模块行
probe=$(mktemp -d)
mkdir -p "$probe/tools/toolchain" "$probe/.work/frontend/typescript-go"
cp "$ROOT/tools/toolchain/go.lock.json" "$probe/tools/toolchain/"
print -- "module github.com/someone/other" > "$probe/.work/frontend/typescript-go/go.mod"
out=$("$ROOT/tools/toolchain/prep" --project "$probe" --verify-only 2>&1); code=$?
if [[ $code -eq 8 ]] && print -- "$out" | grep -q "源码身份不符"; then
  pass "源码身份不符按退出 8 拒绝"
else
  fail "源码身份不符应退出 8，实际退出 $code：$out"
fi
rm -rf "$probe"

# 9. 声明库缺失：只放标记文件，不放 libs 目录
probe=$(mktemp -d)
mkdir -p "$probe/tools/toolchain" "$probe/.work/frontend/typescript-go/internal/compiler"
cp "$ROOT/tools/toolchain/go.lock.json" "$probe/tools/toolchain/"
cp "$TREE/go.mod" "$TREE/LICENSE" "$probe/.work/frontend/typescript-go/"
cp "$TREE/internal/compiler/program.go" "$probe/.work/frontend/typescript-go/internal/compiler/"
out=$("$ROOT/tools/toolchain/prep" --project "$probe" --verify-only 2>&1); code=$?
if [[ $code -eq 8 ]] && print -- "$out" | grep -q "lib.es5.d.ts"; then
  pass "声明库缺失按退出 8 拒绝"
else
  fail "声明库缺失应退出 8，实际退出 $code：$out"
fi
rm -rf "$probe"

# 10. 声明库不完整：只有 lib.es5.d.ts
probe=$(mktemp -d)
mkdir -p "$probe/tools/toolchain" "$probe/.work/frontend/typescript-go/internal/compiler" "$probe/.work/frontend/typescript-go/internal/bundled/libs"
cp "$ROOT/tools/toolchain/go.lock.json" "$probe/tools/toolchain/"
cp "$TREE/go.mod" "$TREE/LICENSE" "$probe/.work/frontend/typescript-go/"
cp "$TREE/internal/compiler/program.go" "$probe/.work/frontend/typescript-go/internal/compiler/"
cp "$TREE/internal/bundled/libs/lib.es5.d.ts" "$probe/.work/frontend/typescript-go/internal/bundled/libs/"
out=$("$ROOT/tools/toolchain/prep" --project "$probe" --verify-only 2>&1); code=$?
if [[ $code -eq 8 ]] && print -- "$out" | grep -q "声明库不完整"; then
  pass "声明库不完整按退出 8 拒绝"
else
  fail "声明库不完整应退出 8，实际退出 $code：$out"
fi
rm -rf "$probe"

# 11. 事实：同名参数不同 ID，前向调用解析到后声明的函数
facts=$(mktemp)
"$BIN" -facts "$ROOT/bridge/tsgo/testdata/facts.ts" >"$facts" 2>/dev/null; code=$?
if [[ $code -eq 0 ]] && python3 - "$facts" <<'FACTSPY'
import json, sys
facts = json.load(open(sys.argv[1]))
params = [d["id"] for d in facts["declarations"] if d["kind"] == "parameter" and d["name"] == "a"]
assert len(params) == 2 and params[0] != params[1], params
call = facts["calls"][0]
callee = next(d for d in facts["declarations"] if d["id"] == call["callee"])
assert callee["name"] == "add" and callee["start"] > call["start"], callee
FACTSPY
then
  pass "事实区分同名参数并解析前向调用"
else
  fail "事实输出不符合预期（退出 $code）"
fi
rm -f "$facts"

# 12. 能力检查：支持子集通过，越界写法按退出 3 拒绝，源码错误优先
CAP="$ROOT/bridge/tsgo/testdata/capability"
out=$("$BIN" -capability "$CAP/ok.ts" 2>&1); code=$?
if [[ $code -eq 0 && "$out" == "[]" ]]; then
  pass "支持子集通过能力检查（退出 0）"
else
  fail "支持子集应通过，实际退出 $code：$out"
fi

for pair in "any.ts:cap.any" "assert.ts:cap.type-escape" "object.ts:cap.unsupported-syntax" \
            "eval.ts:cap.forbidden-global" "dynamic-function.ts:cap.unsupported-syntax" \
            "library.ts:cap.unknown-callee" "uncalled.ts:cap.unsupported-syntax" \
            "void-value.ts:cap.void-value" "shadowed-console.ts:cap.shadowed-console"; do
  file=${pair%%:*}
  want=${pair##*:}
  out=$("$BIN" -capability "$CAP/$file" 2>&1); code=$?
  if [[ $code -eq 3 ]] && print -- "$out" | grep -q "\"$want\""; then
    pass "$file 按退出 3 拒绝（$want）"
  else
    fail "$file 应报 $want 并退出 3，实际退出 $code：$out"
  fi
done

out=$("$BIN" -capability "$ROOT/bridge/tsgo/testdata/bad.ts" 2>&1); code=$?
if [[ $code -eq 1 ]] && print -- "$out" | grep -q '"code": 2322'; then
  pass "源码错误先于能力检查（退出 1）"
else
  fail "源码错误应退出 1，实际退出 $code：$out"
fi

# 给 void 函数返回值、实参个数不符：TypeScript 自己就拒绝，不必等到能力检查。
for pair in "return-value.ts:2322" "arg-count.ts:2554"; do
  file=${pair%%:*}
  want=${pair##*:}
  out=$("$BIN" -capability "$CAP/$file" 2>&1); code=$?
  if [[ $code -eq 1 ]] && print -- "$out" | grep -q "\"code\": $want"; then
    pass "$file 由源码检查拒绝（$want，退出 1）"
  else
    fail "$file 应退出 1 并报 $want，实际退出 $code：$out"
  fi
done

# 13. 降低到 NIR 并运行：源码 → NIR → 原生程序，与手写 NIR 行为一致
TYNEL="$ROOT/bin/tynel"
if [[ ! -x "$TYNEL" ]]; then
  (cd "$ROOT" && ./tools/build >/dev/null 2>&1) || true
fi
if [[ ! -x "$ROOT/.work/bridge/compile" ]]; then
  (cd "$ROOT" && ./bridge/go/build >/dev/null 2>&1) || true
fi

if [[ ! -x "$TYNEL" ]]; then
  fail "找不到 bin/tynel，无法验收降低结果"
else
  tmp=$(mktemp -d)
  lower_case() {
    local file=$1 want=$2 name=${1:t:r}
    local nirfile="$tmp/$name.nir.json" exe="$tmp/$name"
    if ! "$BIN" -nir "$file" >"$nirfile" 2>"$tmp/err"; then
      fail "$name 无法降低：$(<$tmp/err)"
      return
    fi
    if ! "$TYNEL" build-ir "$nirfile" -o "$exe" >/dev/null 2>"$tmp/err"; then
      fail "$name 的 NIR 无法编译：$(<$tmp/err)"
      return
    fi
    local got=$("$exe")
    print -- "$got" > "$tmp/$name.out"
    if [[ "$got" == "$want" ]]; then
      pass "$name 运行输出符合预期"
    else
      fail "$name 输出为 $(printf %q "$got")，期望 $(printf %q "$want")"
    fi
  }
  lower_case "$ROOT/bridge/tsgo/testdata/add.ts" "42"
  lower_case "$ROOT/bridge/tsgo/testdata/lower/order.ts" $'1\n2\n3'
  lower_case "$ROOT/bridge/tsgo/testdata/lower/negzero.ts" "-0"
  lower_case "$ROOT/bridge/tsgo/testdata/lower/forward.ts" "42"
  lower_case "$ROOT/bridge/tsgo/testdata/lower/same-name.ts" "8"
  lower_case "$ROOT/bridge/tsgo/testdata/void.ts" $'7\n8'
  lower_case "$ROOT/bridge/tsgo/testdata/discard.ts" "42"
  lower_case "$ROOT/bridge/tsgo/testdata/boolean.ts" "true"
  lower_case "$ROOT/bridge/tsgo/testdata/branch.ts" $'1\n1\n2\n2'
  lower_case "$ROOT/bridge/tsgo/testdata/branch-chain.ts" $'0\n1\n2'
  lower_case "$ROOT/bridge/tsgo/testdata/branch-nested.ts" $'1\n2\n3'
  lower_case "$ROOT/bridge/tsgo/testdata/branch-single.ts" $'0\n1\n2'
  lower_case "$ROOT/bridge/tsgo/testdata/returns-both.ts" $'-1\n1'
  lower_case "$ROOT/bridge/tsgo/testdata/returns-early.ts" $'1\n2'
  lower_case "$ROOT/bridge/tsgo/testdata/returns-nested.ts" $'0\n1\n2'
  lower_case "$ROOT/bridge/tsgo/testdata/returns-void.ts" "1"
  lower_case "$ROOT/bridge/tsgo/testdata/returns-unreachable.ts" "1"
  lower_case "$ROOT/bridge/tsgo/testdata/short.ts" $'1\nfalse\n3\n4\ntrue\n5\ntrue\n7\n8\ntrue'
  lower_case "$ROOT/bridge/tsgo/testdata/short-result.ts" $'1\n2\nfalse\n3\n5\n6\n7\ntrue'
  lower_case "$ROOT/bridge/tsgo/testdata/short-nested.ts" $'1\n2\n3\nfalse\n4\n5\n6\nfalse\n7\n8\n9\nfalse'
  lower_case "$ROOT/bridge/tsgo/testdata/ternary.ts" $'1\n10\n4\n20'
  lower_case "$ROOT/bridge/tsgo/testdata/ternary-result.ts" $'1\n10\n20\n5'
  lower_case "$ROOT/bridge/tsgo/testdata/ternary-nested.ts" $'1\n2\n20\n3\n4\n40\n6\n7\ntrue'
  lower_case "$ROOT/bridge/tsgo/testdata/combine.ts" $'1\ntrue\n4\n5\n6\nfalse\n7\n9\ntrue'
  lower_case "$ROOT/bridge/tsgo/testdata/combine-ternary.ts" $'1\n2\n20\n3\n4\n50\n2\n5\n70'
  lower_case "$ROOT/bridge/tsgo/testdata/combine-order.ts" $'1\n2\n30\n3\n4\n5\n50\n7\n8\n9\n10\n11'
  lower_case "$ROOT/bridge/tsgo/testdata/let.ts" $'2\n1\ntrue'
  lower_case "$ROOT/bridge/tsgo/testdata/assign.ts" $'4\ntrue'
  lower_case "$ROOT/bridge/tsgo/testdata/assign-order.ts" $'2\n2\n3\n5'
  lower_case "$ROOT/bridge/tsgo/testdata/output.ts" $'0.30000000000000004\n-0\n+Inf\n-Inf\nNaN'

  # 输出逐行读回成 binary64：字符串对得上还不够，值也要对得上。
  if python3 - "$tmp/output.out" <<'OUTPY'
import math, sys
lines = open(sys.argv[1]).read().splitlines()
assert lines == ["0.30000000000000004", "-0", "+Inf", "-Inf", "NaN"], lines
values = [float(x) for x in lines]
assert math.copysign(1.0, values[1]) < 0 and values[1] == 0, values[1]
assert math.isinf(values[2]) and values[2] > 0, values[2]
assert math.isinf(values[3]) and values[3] < 0, values[3]
assert math.isnan(values[4]), values[4]
OUTPY
  then
    pass "输出逐行可读回（含负零与无穷）"
  else
    fail "输出格式或读回不一致"
  fi

  if "$TYNEL" build-ir "$ROOT/examples/ir/add.nir.json" -o "$tmp/hand" >/dev/null 2>&1; then
    hand=$("$tmp/hand")
    gen=$("$tmp/add")
    if [[ "$hand" == "$gen" && "$hand" == "42" ]]; then
      pass "手写 NIR 与源码生成的 NIR 输出一致"
    else
      fail "手写 NIR 输出 $hand，源码生成输出 $gen"
    fi
  else
    fail "手写 NIR 无法编译"
  fi
  rm -rf "$tmp"
fi


# 14. 主命令行：check、build、run、dump 走同一条流程
CLI="$ROOT/bin/tynel"
if [[ ! -x "$CLI" ]]; then
  (cd "$ROOT" && ./tools/build >/dev/null 2>&1) || true
fi
if [[ ! -x "$CLI" ]]; then
  fail "找不到 bin/tynel，无法验收主命令行"
else
  cli_tmp=$(mktemp -d)
  out=$("$CLI" check "$ROOT/bridge/tsgo/testdata/add.ts" 2>&1); code=$?
  if [[ $code -eq 0 ]] && print -- "$out" | grep -q '^ok:'; then
    pass "check 通过并报告 NIR 已验证"
  else
    fail "check 应退出 0 并打印 ok，实际退出 $code：$out"
  fi

  out=$("$CLI" check "$ROOT/bridge/tsgo/testdata/bad.ts" 2>&1); code=$?
  if [[ $code -eq 1 ]] && print -- "$out" | grep -q 'TS2322'; then
    pass "check 把源码错误映射为退出 1"
  else
    fail "源码错误应退出 1，实际 $code：$out"
  fi

  out=$("$CLI" check "$ROOT/bridge/tsgo/testdata/capability/void-value.ts" 2>&1); code=$?
  if [[ $code -eq 3 ]] && print -- "$out" | grep -q 'cap.void-value'; then
    pass "check 把能力限制映射为退出 3"
  else
    fail "能力限制应退出 3，实际 $code：$out"
  fi

  "$CLI" check "$ROOT/bridge/tsgo/testdata/add.ts" --json >"$cli_tmp/check.json" 2>"$cli_tmp/err"; code=$?
  if [[ $code -eq 0 ]] && python3 - "$cli_tmp/check.json" <<'JSONPY'
import json, sys
data = json.load(open(sys.argv[1]))
assert data["summary"]["verified"] is True
JSONPY
  then
    pass "check --json 输出可解析"
  else
    fail "check --json 的输出不可解析"
  fi

  if "$CLI" build "$ROOT/bridge/tsgo/testdata/add.ts" -o "$cli_tmp/app" >/dev/null 2>&1 && [[ "$("$cli_tmp/app")" == "42" ]]; then
    pass "一条 build 生成原生 42"
  else
    fail "build 未能生成可运行的原生程序"
  fi
  if [[ -f "$cli_tmp/app.build.json" ]] && python3 -c "import json,sys; d=json.load(open('$cli_tmp/app.build.json')); assert d['source']['path'].endswith('add.ts'); assert d['input']['sha256']" 2>/dev/null; then
    pass "构建记录同时记下源码与 NIR 身份"
  else
    fail "构建记录缺少源码或 NIR 身份"
  fi

  out=$("$CLI" run "$ROOT/bridge/tsgo/testdata/add.ts" 2>/dev/null); code=$?
  if [[ $code -eq 0 && "$out" == "42" ]]; then
    pass "run 编译并运行本次产物"
  else
    fail "run 应输出 42 并退出 0，实际退出 $code：$out"
  fi

  if "$CLI" dump nir "$ROOT/bridge/tsgo/testdata/add.ts" 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); assert d['entry']=='main'" 2>/dev/null; then
    pass "dump nir 输出可解析"
  else
    fail "dump nir 输出不可解析"
  fi
  if "$CLI" dump facts "$ROOT/bridge/tsgo/testdata/add.ts" 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); assert d['declarations']" 2>/dev/null; then
    pass "dump facts 输出可解析"
  else
    fail "dump facts 输出不可解析"
  fi

  # run 构建失败后不执行已有产物：先放一个会打印 STALE 的假产物。
  mkdir -p "$ROOT/.work/run"
  printf '#!/bin/sh\necho STALE\n' > "$ROOT/.work/run/app"
  chmod +x "$ROOT/.work/run/app"
  out=$("$CLI" run "$ROOT/bridge/tsgo/testdata/bad.ts" 2>&1); code=$?
  if [[ $code -eq 1 ]] && ! print -- "$out" | grep -q STALE; then
    pass "run 在构建失败后不执行已有产物"
  else
    fail "run 不应执行旧产物，实际退出 $code：$out"
  fi
  rm -f "$ROOT/.work/run/app"

  # 不可写输出：环境缺失，与源码错误分开。
  mkdir -p "$cli_tmp/ro"
  chmod 555 "$cli_tmp/ro"
  "$CLI" build "$ROOT/bridge/tsgo/testdata/add.ts" -o "$cli_tmp/ro/app" >/dev/null 2>&1; code=$?
  chmod 755 "$cli_tmp/ro"
  if [[ $code -eq 4 ]]; then
    pass "不可写输出按环境缺失退出 4"
  else
    fail "不可写输出应退出 4，实际 $code"
  fi

  # check 不依赖后端：把修改版编译器移走，check 仍通过，build 变环境缺失。
  moved=0
  if [[ -f "$ROOT/.work/bridge/compile" ]]; then
    mv "$ROOT/.work/bridge/compile" "$cli_tmp/compile.away"
    moved=1
  fi
  "$CLI" check "$ROOT/bridge/tsgo/testdata/add.ts" >/dev/null 2>&1; code=$?
  "$CLI" build "$ROOT/bridge/tsgo/testdata/add.ts" -o "$cli_tmp/nobackend" >/dev/null 2>&1; build_code=$?
  if [[ $moved -eq 1 ]]; then
    mv "$cli_tmp/compile.away" "$ROOT/.work/bridge/compile"
  fi
  if [[ $code -eq 0 && $build_code -eq 4 ]]; then
    pass "check 不依赖后端，build 缺后端按环境缺失退出 4"
  else
    fail "check 应通过（0）且 build 应报环境缺失（4），实际 $code / $build_code"
  fi

  rm -rf "$cli_tmp"
fi

print -- ""
if [[ $failures -eq 0 ]]; then
  print -- "全部通过"
  exit 0
fi
print -- "失败 $failures 项"
exit 1
